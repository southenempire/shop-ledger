# Copy to .env and fill in. Never commit .env.
# Create a bot with @BotFather in Telegram and paste its token here.
TELEGRAM_BOT_TOKEN=

# Optional: comma-separated Telegram chat ids allowed to use the bot.
# If empty, the first person to send /start becomes the owner.
# ALLOWED_CHAT_IDS=

# Optional: local time (HH:MM) for the automatic daily summary. Default 20:00.
# SUMMARY_TIME=20:00

# Optional: speech model constant exported by @qvac/sdk. Default WHISPER_EN_BASE_Q8_0.
# SHOP_STT_MODEL=WHISPER_EN_BASE_Q8_0
